<section class="grow">
        <div class="grow-content">
          <h1 class="c-section-title grow-content-title">
            <span class="--highlight">Experience Growth</span> and Elevate Your Career with Us
          </h1>
          <div class="grow-content-img c-media-cover">
            <img src="https://rmkcdn.successfactors.com/0da85466/0793745d-f106-4148-9cf8-9.png" alt="" />
          </div>
          <div class="grow-content-cta">
            <button class="c-btn c-btn--primary js-modal-btn-trigger" data-target="js-modal-manifesto">
              <img src="https://rmkcdn.successfactors.com/feaf7fda/cca4cab1-0121-4909-a3ad-4.svg" alt="" />
              <span>GROW Manifesto</span>
            </button>
            <button
              class="c-btn c-btn--transparent js-modal-btn-trigger grow-content-cta-jingle"
              data-target="js-modal-jingle"
            >
              <img src="https://rmkcdn.successfactors.com/feaf7fda/d51ccbff-1c15-44fd-8689-0.svg" alt="" />
